 		dev_err(dev, "Unsupported smbus protocol %d\n", f7_msg->size);
 		return -EOPNOTSUPP;
-	};
+	}
 
 	f7_msg->buf = f7_msg->smbus_buf;
 
@@ -941,7 +941,7 @@ static void stm32f7_i2c_smbus_rep_start(
