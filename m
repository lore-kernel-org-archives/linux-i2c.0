 		cr2 |= STM32F7_I2C_CR2_RELOAD;
 		break;
-	};
+	}
 
 	f7_msg->buf = f7_msg->smbus_buf;
 	f7_msg->stop = true;
@@ -992,7 +992,7 @@ static int stm32f7_i2c_smbus_check_pec(s
